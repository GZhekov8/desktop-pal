{
  "name": "desktop-pal",
  "version": "1.7.0",
  "description": "A desktop pet that sits in the corner of your screen and reminds you of things",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:art": "python3 tools/build.py",
    "test": "node tools/unit.js",
    "test:e2e": "node tools/e2e.js && node tools/e2e16.js && node tools/e2e17.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:local": "electron-builder --win --x64 --publish never -c.electronDist=dl/electron-win"
  },
  "keywords": [],
  "author": "Desktop Pal",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.10.0",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1",
    "resedit": "^3.1.0"
  },
  "productName": "Desktop Pal",
  "homepage": "https://github.com/GZhekov8/desktop-pal/releases",
  "build": {
    "appId": "com.otterpal.reminders",
    "productName": "Desktop Pal",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "!src/**/*.map"
    ],
    "electronVersion": "44.10.0",
    "afterPack": "build/afterPack.js",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "DesktopPal-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desktop Pal",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Desktop Pal",
      "artifactName": "DesktopPal-${version}-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "electronLanguages": [
      "en-US",
      "en-GB",
      "bg"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "native/gamecheck.exe",
        "to": "gamecheck.exe"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GZhekov8/desktop-pal"
  }
}
